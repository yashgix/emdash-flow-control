diff --git a/packages/wire/src/api/credit-client.test.ts b/packages/wire/src/api/credit-client.test.ts
new file mode 100644
index 000000000..ff0104216
--- /dev/null
+++ b/packages/wire/src/api/credit-client.test.ts
@@ -0,0 +1,285 @@
+import type { Unsubscribe } from '@emdash/shared';
+import type { TimerHandle } from '@emdash/shared/scheduling';
+import { describe, expect, it } from 'vitest';
+import type { LiveUpdate } from './channel';
+import { connect } from './connect';
+import { creditSize, type WireMessage, type WireTransport } from './protocol';
+import { serve } from './serve';
+import { memoryTransportPair } from './transports';
+
+const CREDIT_IDLE_MS = 50;
+
+class ManualClock {
+  private current = 0;
+  private nextId = 1;
+  private timers: { id: number; callback: () => void; due: number }[] = [];
+
+  now(): number {
+    return this.current;
+  }
+
+  sleep(ms: number): Promise<void> {
+    return new Promise((resolve) => setTimeout(resolve, ms));
+  }
+
+  schedule(delayMs: number, callback: () => void, _options?: { unref?: boolean }): TimerHandle {
+    const id = this.nextId++;
+    const due = this.current + delayMs;
+    this.timers.push({ id, callback, due });
+    const timers = () => this.timers;
+    return {
+      get active() {
+        return timers().some((timer) => timer.id === id);
+      },
+      dispose: () => {
+        this.timers = this.timers.filter((timer) => timer.id !== id);
+      },
+    };
+  }
+
+  advance(ms: number): void {
+    this.current += ms;
+    const due = this.timers
+      .filter((timer) => timer.due <= this.current)
+      .sort((a, b) => a.due - b.due);
+    this.timers = this.timers.filter((timer) => timer.due > this.current);
+    for (const timer of due) timer.callback();
+  }
+}
+
+class TestTransport implements WireTransport {
+  readonly sent: WireMessage[] = [];
+  private readonly messageListeners = new Set<(message: WireMessage) => void>();
+  private readonly disconnectListeners = new Set<() => void>();
+  private readonly reconnectListeners = new Set<() => void>();
+
+  constructor(private readonly attachResult: unknown = undefined) {}
+
+  post(message: WireMessage): void {
+    this.sent.push(message);
+    if (message.kind === 'attach') {
+      const result = this.attachResult;
+      queueMicrotask(() => {
+        for (const listener of this.messageListeners) {
+          listener({ kind: 'result', id: message.id, ok: true, value: result });
+        }
+      });
+    }
+  }
+
+  onMessage(cb: (message: WireMessage) => void): Unsubscribe {
+    this.messageListeners.add(cb);
+    return () => this.messageListeners.delete(cb);
+  }
+
+  onDisconnect(cb: () => void): Unsubscribe {
+    this.disconnectListeners.add(cb);
+    return () => this.disconnectListeners.delete(cb);
+  }
+
+  onReconnect(cb: () => void): Unsubscribe {
+    this.reconnectListeners.add(cb);
+    return () => this.reconnectListeners.delete(cb);
+  }
+
+  emit(message: WireMessage): void {
+    for (const listener of [...this.messageListeners]) listener(message);
+  }
+
+  reconnect(): void {
+    for (const listener of [...this.reconnectListeners]) listener();
+  }
+
+  get attachMessages(): Extract<WireMessage, { kind: 'attach' }>[] {
+    return this.sent.filter((message) => message.kind === 'attach') as Extract<
+      WireMessage,
+      { kind: 'attach' }
+    >[];
+  }
+
+  get topicCreditMessages(): Extract<WireMessage, { kind: 'topic-credit' }>[] {
+    return this.sent.filter((message) => message.kind === 'topic-credit') as Extract<
+      WireMessage,
+      { kind: 'topic-credit' }
+    >[];
+  }
+}
+
+class QueueLiveSource {
+  private subscribers = new Set<(update: unknown) => void>();
+
+  subscribe(push: (update: unknown) => void, _options: unknown): Unsubscribe {
+    this.subscribers.add(push);
+    return () => this.subscribers.delete(push);
+  }
+
+  emit(update: unknown): void {
+    for (const subscriber of [...this.subscribers]) subscriber(update);
+  }
+}
+
+function update(sequence: number): LiveUpdate {
+  return {
+    generation: 0,
+    baseSequence: 0,
+    sequence,
+    timestamp: 0,
+    delta: undefined,
+  };
+}
+
+// One update's credit units; a window of eight updates reports at a quarter, two updates.
+const SIZE = creditSize(update(0));
+const WINDOW = 8 * SIZE;
+
+async function flush(): Promise<void> {
+  await new Promise((resolve) => setTimeout(resolve, 0));
+}
+
+async function waitFor(condition: () => boolean): Promise<void> {
+  const start = Date.now();
+  while (!condition()) {
+    if (Date.now() - start > 2_000) throw new Error('timed out waiting for condition');
+    await new Promise((resolve) => setTimeout(resolve, 0));
+  }
+}
+
+describe('connect credit client', () => {
+  it('sends the attach window only when creditWindow is configured', async () => {
+    const withoutWindow = new TestTransport();
+    const noWindowConnection = connect(withoutWindow);
+    await noWindowConnection.attach('topic', () => {});
+
+    expect(withoutWindow.attachMessages).toHaveLength(1);
+    expect(withoutWindow.attachMessages[0]).not.toHaveProperty('window');
+    noWindowConnection.dispose();
+
+    const withWindow = new TestTransport({ window: 7 });
+    const windowConnection = connect(withWindow, { creditWindow: 7 });
+    await windowConnection.attach('topic', () => {});
+
+    expect(withWindow.attachMessages).toHaveLength(1);
+    expect(withWindow.attachMessages[0]).toMatchObject({ window: 7 });
+    windowConnection.dispose();
+  });
+
+  it('reports credit at a quarter window and after the idle delay', async () => {
+    const transport = new TestTransport({ window: WINDOW });
+    const clock = new ManualClock();
+    const connection = connect(transport, { creditWindow: WINDOW, clock });
+
+    await connection.attach('items', () => {});
+    transport.sent.length = 0;
+
+    transport.emit({ kind: 'update', topic: 'items', update: update(0), flow: true });
+    await flush();
+    expect(transport.topicCreditMessages).toHaveLength(0);
+
+    clock.advance(CREDIT_IDLE_MS);
+    expect(transport.topicCreditMessages).toHaveLength(1);
+    expect(transport.topicCreditMessages[0]).toMatchObject({
+      topic: 'items',
+      consumed: SIZE,
+    });
+
+    transport.sent.length = 0;
+    transport.emit({ kind: 'update', topic: 'items', update: update(0), flow: true });
+    transport.emit({ kind: 'update', topic: 'items', update: update(1), flow: true });
+    await flush();
+
+    expect(transport.topicCreditMessages).toHaveLength(1);
+    expect(transport.topicCreditMessages[0]).toMatchObject({
+      topic: 'items',
+      consumed: 3 * SIZE,
+    });
+    connection.dispose();
+  });
+
+  it('resets credit counters on reconnect', async () => {
+    const transport = new TestTransport({ window: WINDOW });
+    const clock = new ManualClock();
+    const connection = connect(transport, { creditWindow: WINDOW, clock });
+
+    await connection.attach('items', () => {});
+    transport.sent.length = 0;
+
+    transport.emit({ kind: 'update', topic: 'items', update: update(0), flow: true });
+    clock.advance(CREDIT_IDLE_MS);
+    expect(transport.topicCreditMessages[0]).toMatchObject({ consumed: SIZE });
+
+    transport.sent.length = 0;
+    transport.reconnect();
+    await waitFor(() => transport.attachMessages.length >= 1);
+    await flush();
+
+    transport.emit({ kind: 'update', topic: 'items', update: update(0), flow: true });
+    await flush();
+    expect(transport.topicCreditMessages).toHaveLength(0);
+
+    clock.advance(CREDIT_IDLE_MS);
+    expect(transport.topicCreditMessages).toHaveLength(1);
+    expect(transport.topicCreditMessages[0]).toMatchObject({
+      topic: 'items',
+      consumed: SIZE,
+    });
+    connection.dispose();
+  });
+
+  it('does not send credit to a server that did not return a window', async () => {
+    const transport = new TestTransport();
+    const clock = new ManualClock();
+    const connection = connect(transport, { creditWindow: 4, clock });
+
+    await connection.attach('items', () => {});
+    transport.sent.length = 0;
+
+    transport.emit({ kind: 'update', topic: 'items', update: update(0), flow: true });
+    await flush();
+    clock.advance(CREDIT_IDLE_MS);
+
+    expect(transport.topicCreditMessages).toHaveLength(0);
+    connection.dispose();
+  });
+
+  it('delivers a burst of window * 10 updates in order without topic-gap', async () => {
+    const source = new QueueLiveSource();
+    const controller = {
+      call: async () => {
+        throw new Error('unused');
+      },
+      acquireLive: (topic: string) => {
+        if (topic !== 'items') return undefined;
+        return { ready: async () => source, release: async () => {} };
+      },
+    } as unknown as Parameters<typeof serve>[1];
+
+    const pair = memoryTransportPair();
+    const disposeServer = serve(pair.right, controller);
+    const connection = connect(pair.left, { creditWindow: 4 });
+    const updates: number[] = [];
+    let gaps = 0;
+
+    const detach = await connection.attach(
+      'items',
+      (update) => {
+        updates.push(update.sequence);
+      },
+      {
+        onReattach: () => {
+          gaps += 1;
+        },
+      }
+    );
+
+    for (let seq = 0; seq < 40; seq += 1) source.emit(update(seq));
+
+    await waitFor(() => updates.length === 40);
+    expect(updates).toEqual(Array.from({ length: 40 }, (_, seq) => seq));
+    expect(gaps).toBe(0);
+
+    detach();
+    connection.dispose();
+    disposeServer();
+    pair.disconnect();
+  });
+});
diff --git a/packages/wire/src/api/credit-gate.test.ts b/packages/wire/src/api/credit-gate.test.ts
new file mode 100644
index 000000000..b8994f4c5
--- /dev/null
+++ b/packages/wire/src/api/credit-gate.test.ts
@@ -0,0 +1,476 @@
+import { describe, expect, it } from 'vitest';
+import { createCreditGate } from './credit-gate';
+
+type Update = { sequence: number };
+
+function createGate(
+  overrides: {
+    window?: number;
+    stallMs?: number;
+    pauseAt?: number;
+    resumeAt?: number;
+    maxPending?: number;
+  } = {}
+) {
+  let time = 0;
+  const sent: Update[] = [];
+  const pressures: boolean[] = [];
+  const overflows: number[] = [];
+
+  const gate = createCreditGate<Update>({
+    window: overrides.window ?? 100,
+    stallMs: overrides.stallMs ?? 30_000,
+    pauseAt: overrides.pauseAt ?? 256 * 1024,
+    resumeAt: overrides.resumeAt ?? 128 * 1024,
+    maxPending: overrides.maxPending ?? 1024 * 1024,
+    now: () => time,
+    send: (update) => sent.push(update),
+    onPressure: (pressured) => pressures.push(pressured),
+    onOverflow: () => overflows.push(time),
+  });
+
+  return {
+    gate,
+    sent,
+    pressures,
+    overflows,
+    now: () => time,
+    advance(milliseconds: number) {
+      time += milliseconds;
+    },
+  };
+}
+
+const CHUNK = 16 * 1024;
+const STEP_MS = 10;
+const MIN_WINDOW = 64 * 1024;
+const MAX_WINDOW = 4 * 1024 * 1024;
+
+// A saturating producer behind a link: updates reach the client rttMs after
+// they are sent, and the client credits at most bytesPerMs. Returns the gate
+// window after every step.
+function simulateLink({
+  rttMs,
+  bytesPerMs = Infinity,
+  durationMs,
+  reportEveryMs = STEP_MS,
+}: {
+  rttMs: number | ((elapsedMs: number) => number);
+  bytesPerMs?: number;
+  durationMs: number;
+  /** The client reports this rarely, each time as two reports 1 ms apart (a batch the link delivered together). */
+  reportEveryMs?: number;
+}): number[] {
+  const { gate, sent, advance, now } = createGate({
+    window: MIN_WINDOW,
+    stallMs: Infinity,
+    pauseAt: Infinity,
+    maxPending: Infinity,
+  });
+  const sentAt: number[] = [];
+  const windows: number[] = [];
+  let sequence = 0;
+  let credited = 0;
+  let readable = 0; // bytes the client has received and could credit
+
+  function pump(): void {
+    while (gate.pendingBytes < 1024 * 1024) {
+      gate.offer({ sequence: sequence++ }, CHUNK);
+    }
+    while (sentAt.length < sent.length) sentAt.push(now());
+  }
+
+  pump();
+  for (let elapsed = 0; elapsed < durationMs; elapsed += STEP_MS) {
+    advance(STEP_MS);
+    const rtt = typeof rttMs === 'number' ? rttMs : rttMs(elapsed);
+    const arrived = sentAt.filter((at) => at <= now() - rtt).length * CHUNK;
+    readable = Math.min(arrived, readable + bytesPerMs * STEP_MS);
+    const target = readable;
+    if (target > credited && (elapsed + STEP_MS) % reportEveryMs === 0) {
+      if (reportEveryMs > STEP_MS) {
+        gate.credit(credited + Math.floor((target - credited) / 2));
+        advance(1);
+      }
+      credited = target;
+      gate.credit(credited);
+      pump();
+    }
+    windows.push(gate.window);
+  }
+  return windows;
+}
+
+describe('createCreditGate', () => {
+  it('sends while the window allows and drains queued updates in order', () => {
+    const { gate, sent } = createGate({ window: 100 });
+
+    gate.offer({ sequence: 1 }, 60);
+    gate.offer({ sequence: 2 }, 50);
+    gate.offer({ sequence: 3 }, 10);
+
+    expect(sent).toEqual([{ sequence: 1 }]);
+    expect(gate.pendingBytes).toBe(60);
+
+    gate.credit(60);
+
+    expect(sent.map(({ sequence }) => sequence)).toEqual([1, 2, 3]);
+    expect(gate.pendingBytes).toBe(0);
+  });
+
+  it('sends an oversized update when nothing is in flight, then queues until credit clears it', () => {
+    const { gate, sent } = createGate({ window: 10 });
+
+    gate.offer({ sequence: 1 }, 100);
+    gate.offer({ sequence: 2 }, 5);
+
+    expect(sent).toEqual([{ sequence: 1 }]);
+
+    gate.credit(100);
+
+    expect(sent.map(({ sequence }) => sequence)).toEqual([1, 2]);
+  });
+
+  it('clamps credit to sent and ignores a credit below the last one', () => {
+    const { gate } = createGate({ window: 50 });
+
+    gate.offer({ sequence: 1 }, 20);
+    gate.credit(15);
+    gate.credit(10);
+    expect(gate.consumed).toBe(15);
+
+    gate.credit(500);
+    expect(gate.consumed).toBe(20);
+  });
+
+  it('fires pressure once on the way up and once on the way down', () => {
+    const { gate, pressures } = createGate({ window: 10, pauseAt: 200, resumeAt: 100 });
+
+    gate.offer({ sequence: 1 }, 10);
+    gate.offer({ sequence: 2 }, 100);
+    gate.offer({ sequence: 3 }, 100);
+    gate.offer({ sequence: 4 }, 50);
+
+    expect(pressures).toEqual([true]);
+
+    gate.credit(10);
+    expect(pressures).toEqual([true]);
+
+    gate.credit(110);
+    expect(pressures).toEqual([true, false]);
+    expect(gate.pendingBytes).toBe(50);
+  });
+
+  it('overflows when pending would exceed maxPending and clears the queue', () => {
+    const { gate, sent, pressures, overflows } = createGate({
+      window: 10,
+      pauseAt: 50,
+      resumeAt: 25,
+      maxPending: 100,
+    });
+
+    gate.offer({ sequence: 1 }, 10);
+    gate.offer({ sequence: 2 }, 90);
+    gate.offer({ sequence: 3 }, 20);
+
+    expect(overflows).toHaveLength(1);
+    expect(pressures).toEqual([true, false]);
+    expect(gate.pendingBytes).toBe(0);
+    expect(sent).toEqual([{ sequence: 1 }]);
+  });
+
+  it('overflows after a stall with a fake clock and does not repeat immediately', () => {
+    const { gate, sent, overflows, advance } = createGate({ window: 10, stallMs: 100 });
+
+    gate.offer({ sequence: 1 }, 10);
+    gate.offer({ sequence: 2 }, 20);
+    advance(100);
+    gate.check();
+
+    expect(overflows).toHaveLength(1);
+    expect(gate.pendingBytes).toBe(0);
+    expect(sent).toEqual([{ sequence: 1 }]);
+
+    gate.check();
+    expect(overflows).toHaveLength(1);
+  });
+
+  it('dispose releases pressure and drops queued updates', () => {
+    const { gate, sent, pressures } = createGate({ window: 10, pauseAt: 50, resumeAt: 25 });
+
+    gate.offer({ sequence: 1 }, 10);
+    gate.offer({ sequence: 2 }, 40);
+    gate.offer({ sequence: 3 }, 20);
+    expect(pressures).toEqual([true]);
+
+    gate.dispose();
+    expect(pressures).toEqual([true, false]);
+    expect(gate.pendingBytes).toBe(0);
+
+    gate.offer({ sequence: 4 }, 10);
+    gate.credit(100);
+    expect(sent).toEqual([{ sequence: 1 }]);
+    expect(gate.consumed).toBe(0);
+  });
+
+  it('grows past 1 MiB within 10 round trips on a fast link and respects maxWindow', () => {
+    const windows = simulateLink({ rttMs: 300, durationMs: 3_000 });
+
+    expect(windows[windows.length - 1]).toBeGreaterThan(1024 * 1024);
+    expect(Math.max(...windows)).toBeLessThanOrEqual(MAX_WINDOW);
+  });
+
+  it('keeps the minimum window on a slow shared link', () => {
+    // Stays inside the 10 s RTT memory: the first RTT sample is the minimum.
+    const windows = simulateLink({
+      rttMs: 300,
+      bytesPerMs: 40,
+      durationMs: 9_000,
+    });
+
+    expect(Math.max(...windows)).toBeLessThan(MIN_WINDOW * 1.25);
+  });
+
+  it('keeps a small window when credit reports arrive in batches on a slow link', () => {
+    // Two reports 1 ms apart once a round trip must not read as a burst of bandwidth.
+    const windows = simulateLink({
+      rttMs: 300,
+      bytesPerMs: 40,
+      durationMs: 9_000,
+      reportEveryMs: 300,
+    });
+
+    expect(Math.max(...windows)).toBeLessThan(MIN_WINDOW * 1.25);
+  });
+
+  it('stops growing once the round trip shows its own bytes queued', () => {
+    // Unlimited rate but a queue building on the path: RTT climbs from 300 ms to 3 s.
+    const windows = simulateLink({
+      rttMs: (elapsed) => 300 + elapsed / 3,
+      durationMs: 8_000,
+    });
+    // Once the queue shows (RTT past twice the minimum plus slack, about 1 s in), the window holds.
+    const held = windows[200]!;
+    expect(Math.max(...windows.slice(200))).toBe(held);
+    expect(held).toBeLessThan(MIN_WINDOW * 4);
+  });
+
+  it('keeps the minimum window for an app-limited topic', () => {
+    const { gate, advance } = createGate({ window: MIN_WINDOW });
+
+    for (let sequence = 0; sequence < 30; sequence++) {
+      gate.offer({ sequence }, 1000);
+      advance(100);
+      gate.credit(gate.sent);
+      advance(900);
+    }
+
+    expect(gate.window).toBe(MIN_WINDOW);
+  });
+
+  it('expires RTT and rate samples older than 10 s', () => {
+    const { gate, advance } = createGate({ window: 100 });
+
+    gate.offer({ sequence: 1 }, 100);
+    advance(100);
+    gate.credit(100);
+    expect(gate.window).toBe(200);
+
+    advance(20_000);
+    gate.offer({ sequence: 2 }, 200);
+    advance(400);
+    gate.credit(300);
+
+    // The old 100 ms RTT and its high rate sample are both gone.
+    expect(gate.window).toBe(400);
+  });
+
+  it('uses the minimum window until the first rate sample', () => {
+    const { gate, advance } = createGate({ window: 100 });
+
+    gate.offer({ sequence: 1 }, 10);
+    advance(5);
+    gate.credit(10);
+
+    expect(gate.window).toBe(100);
+  });
+
+  it('halves the window once, not to the minimum, when all rate samples have expired', () => {
+    const { gate, advance } = createGate({ window: 100 });
+
+    gate.offer({ sequence: 1 }, 100);
+    advance(100);
+    gate.credit(100);
+    expect(gate.window).toBe(200);
+
+    advance(20_000);
+    gate.offer({ sequence: 2 }, 50);
+    advance(100);
+    gate.credit(150);
+
+    expect(gate.window).toBe(100);
+  });
+
+  it('does not create sent-log marks for zero-byte updates', () => {
+    const { gate, sent, advance } = createGate({
+      window: 10_000,
+      stallMs: Infinity,
+      pauseAt: Infinity,
+      maxPending: Infinity,
+    });
+
+    gate.offer({ sequence: 0 }, 10_000);
+    advance(100);
+    gate.credit(10_000);
+    expect(gate.window).toBeCloseTo(20_000, 6);
+
+    advance(50);
+    gate.offer({ sequence: 1 }, 20_000);
+
+    for (let sequence = 2; sequence <= 10_001; sequence += 1) {
+      advance(0.01);
+      gate.offer({ sequence }, 0);
+    }
+
+    advance(10);
+    gate.credit(30_000);
+
+    // Zero-byte marks would make the newest credit sample 10 ms old and inflate
+    // the window to roughly 400,000 bytes.
+    expect(gate.window).toBeCloseTo(36_364, 0);
+    expect(sent[0]).toEqual({ sequence: 0 });
+    expect(sent[1]).toEqual({ sequence: 1 });
+    expect(sent).toHaveLength(10_002);
+  });
+
+  it('bounds the send log without stale baselines', () => {
+    const { gate, advance } = createGate({
+      window: 10_000,
+      stallMs: Infinity,
+      pauseAt: Infinity,
+      maxPending: Infinity,
+    });
+
+    gate.offer({ sequence: 0 }, 10_000);
+    advance(100);
+    gate.credit(10_000);
+    expect(gate.window).toBeCloseTo(20_000, 6);
+
+    for (let sequence = 1; sequence <= 1_000; sequence += 1) {
+      advance(1);
+      gate.offer({ sequence }, 1);
+    }
+
+    // Leave 100 bytes in flight so the next burst builds a long send log.
+    advance(1);
+    gate.credit(10_900);
+
+    for (let sequence = 1_001; sequence <= 10_000; sequence += 1) {
+      advance(1);
+      gate.offer({ sequence }, 1);
+    }
+
+    // Make the final credit sample while the gate is window-limited.
+    gate.offer({ sequence: 10_001 }, 11_000);
+
+    advance(100);
+    gate.credit(20_000);
+
+    // 9,100 bytes were credited over a 100 ms final RTT, against the 100 ms
+    // minimum RTT; a stale last mark would keep the window at the minimum.
+    expect(gate.window).toBeCloseTo(18_200, 6);
+  });
+
+  it('interpolates send time for credit positions between compacted marks', () => {
+    const { gate, advance, now } = createGate({
+      window: 1025,
+      stallMs: Infinity,
+      pauseAt: Infinity,
+      maxPending: Infinity,
+    });
+
+    let sequence = 0;
+    gate.offer({ sequence: sequence++ }, 1);
+    advance(10);
+    gate.credit(1);
+
+    const batchStart = now();
+    for (let index = 1; index <= 1025; index += 1) {
+      advance(5);
+      gate.offer({ sequence: sequence++ }, 1);
+    }
+
+    const expectedRtt = now() - (batchStart + 1023 * 5);
+    gate.credit(1024);
+
+    expect(gate.window).toBeCloseTo(2 * ((1024 - 1) / expectedRtt) * 10, 6);
+  });
+
+  it('shrinks a stale window by the periods elapsed, down to the minimum after a long idle gap', () => {
+    const { gate, advance } = createGate({
+      window: 100,
+      stallMs: Infinity,
+      pauseAt: Infinity,
+      maxPending: Infinity,
+    });
+
+    gate.offer({ sequence: 1 }, 100);
+    advance(100);
+    gate.credit(100);
+    const grown = gate.window;
+    expect(grown).toBeGreaterThan(100);
+
+    advance(3_600_000);
+    gate.offer({ sequence: 2 }, 10);
+    advance(100);
+    gate.credit(110);
+
+    expect(gate.window).toBe(100);
+  });
+
+  it('halves the window gradually after rate samples expire, never below the minimum', () => {
+    const { gate, advance } = createGate({
+      window: 100,
+      stallMs: Infinity,
+      pauseAt: Infinity,
+      maxPending: Infinity,
+    });
+
+    let sequence = 0;
+    gate.offer({ sequence: sequence++ }, 1000);
+    advance(100);
+    gate.credit(1000);
+    expect(gate.window).toBeCloseTo(2000, 6);
+
+    advance(11_000);
+
+    const creditSparse = () => {
+      advance(1);
+      gate.offer({ sequence: sequence++ }, 100);
+      advance(10);
+      gate.credit(gate.sent);
+    };
+
+    creditSparse();
+    expect(gate.window).toBeCloseTo(1000, 6);
+
+    creditSparse();
+    expect(gate.window).toBeCloseTo(1000, 6);
+
+    advance(10_000);
+    creditSparse();
+    expect(gate.window).toBeCloseTo(500, 6);
+
+    advance(10_000);
+    creditSparse();
+    expect(gate.window).toBeCloseTo(250, 6);
+
+    advance(10_000);
+    creditSparse();
+    expect(gate.window).toBeCloseTo(125, 6);
+
+    advance(10_000);
+    creditSparse();
+    expect(gate.window).toBe(100);
+  });
+});
diff --git a/packages/wire/src/api/credit-gate.ts b/packages/wire/src/api/credit-gate.ts
new file mode 100644
index 000000000..373c65d6a
--- /dev/null
+++ b/packages/wire/src/api/credit-gate.ts
@@ -0,0 +1,310 @@
+export type CreditGate<T = unknown> = {
+  readonly sent: number;
+  readonly consumed: number;
+  readonly pendingBytes: number;
+  readonly pressured: boolean;
+  readonly window: number;
+  offer(update: T, bytes: number): void;
+  credit(consumed: number): void;
+  check(): void;
+  dispose(): void;
+};
+
+type QueuedUpdate<T> = {
+  update: T;
+  bytes: number;
+};
+
+type SentMark = {
+  end: number;
+  at: number;
+  /** Bytes credited when this mark was sent, so a sample spans at least one round trip. */
+  consumedAtSend: number;
+  /** True once compaction folded an earlier send into this mark. */
+  merged?: boolean;
+};
+
+type RttSample = {
+  rtt: number;
+  at: number;
+};
+
+type RateSample = {
+  rate: number;
+  at: number;
+};
+
+const RTT_MEMORY_MS = 10_000;
+const RATE_SAMPLES = 8;
+const QUEUE_SLACK_MS = 50;
+const MAX_SENT_LOG_MARKS = 1_024;
+
+type CreditGateOptions<T> = {
+  window: number;
+  send: (update: T) => void;
+  onPressure: (pressured: boolean) => void;
+  onOverflow: () => void;
+  now?: () => number;
+  stallMs?: number;
+  pauseAt?: number;
+  resumeAt?: number;
+  maxPending?: number;
+  maxWindow?: number;
+};
+
+export function createCreditGate<T>({
+  window: minWindow,
+  send,
+  onPressure,
+  onOverflow,
+  now = () => performance.now(),
+  stallMs = 30_000,
+  pauseAt = 256 * 1024,
+  resumeAt = 128 * 1024,
+  maxPending = 1024 * 1024,
+  maxWindow = 4 * 1024 * 1024,
+}: CreditGateOptions<T>): CreditGate<T> {
+  let queue: QueuedUpdate<T>[] = [];
+  let sent = 0;
+  let consumed = 0;
+  let pendingBytes = 0;
+  let pressured = false;
+  let disposed = false;
+  let inFlightSince: number | undefined;
+  let effectiveWindow = minWindow;
+  const sentLog: SentMark[] = [];
+  // Increasing in rtt, so the front is the minimum of the unexpired samples.
+  const rttSamples: RttSample[] = [];
+  const rateSamples: RateSample[] = [];
+  let latestRtt = 0;
+  let hasSampledRate = false;
+  let lastShrinkAt: number | undefined;
+  let lastRateAt = 0;
+
+  function currentTime(): number {
+    return now();
+  }
+
+  function markInFlight(): void {
+    if (sent > consumed) {
+      if (inFlightSince === undefined) inFlightSince = currentTime();
+    } else {
+      inFlightSince = undefined;
+    }
+  }
+
+  function setPressure(next: boolean): void {
+    if (pressured === next) return;
+    pressured = next;
+    onPressure(next);
+  }
+
+  function canSend(bytes: number): boolean {
+    return sent - consumed + bytes <= effectiveWindow || sent - consumed === 0;
+  }
+
+  function sendUpdate(update: T, bytes: number): void {
+    send(update);
+    if (bytes === 0) return;
+    sent += bytes;
+    if (sentLog.length >= MAX_SENT_LOG_MARKS) {
+      // Halve the log by merging adjacent pairs after the first mark into their
+      // later mark; the oldest mark stays so every credit still finds one.
+      const merged: SentMark[] = [sentLog[0]!];
+      for (let index = 2; index < sentLog.length; index += 2) {
+        merged.push({ ...sentLog[index]!, merged: true });
+      }
+      if (sentLog.length % 2 === 0) merged.push(sentLog[sentLog.length - 1]!);
+      sentLog.splice(0, sentLog.length, ...merged);
+    }
+    sentLog.push({ end: sent, at: currentTime(), consumedAtSend: consumed });
+    markInFlight();
+  }
+
+  function overflow(): void {
+    queue.length = 0;
+    pendingBytes = 0;
+    setPressure(false);
+    // A gap resets the peer's view; restart the stall clock for bytes already
+    // in flight so we do not gap again until another full stall period passes.
+    if (sent > consumed) inFlightSince = currentTime();
+    onOverflow();
+  }
+
+  function checkStall(): void {
+    if (
+      sent > consumed &&
+      inFlightSince !== undefined &&
+      currentTime() - inFlightSince >= stallMs
+    ) {
+      overflow();
+    }
+  }
+
+  // Queued updates or a full window mean the credit rate was the limit, not
+  // the app; only then is a delivery-rate sample taken.
+  function windowLimited(): boolean {
+    return queue.length > 0 || sent - consumed >= effectiveWindow;
+  }
+
+  // BBR-style delivery-rate estimate: bytes credited since the newest now
+  // credited byte was sent, over the time since it was sent. It spans a full
+  // round trip, so two credit reports arriving together cannot fake a burst.
+  function recordSamples(nextConsumed: number, at: number): void {
+    let newest: SentMark | undefined;
+    while (sentLog.length > 0 && sentLog[0]!.end <= nextConsumed) {
+      newest = sentLog.shift();
+    }
+    if (newest === undefined) return;
+    const nextMark = sentLog[0];
+    // Only a merged mark hides an earlier send; estimate its time by byte offset.
+    if (nextMark?.merged && nextConsumed < nextMark.end) {
+      const span = nextMark.end - newest.end;
+      if (span > 0) {
+        const fraction = (nextConsumed - newest.end) / span;
+        newest = {
+          end: nextConsumed,
+          at: newest.at + (nextMark.at - newest.at) * fraction,
+          consumedAtSend:
+            newest.consumedAtSend + (nextMark.consumedAtSend - newest.consumedAtSend) * fraction,
+        };
+      }
+    }
+    const rtt = at - newest.at;
+    if (rtt > 0 && windowLimited()) {
+      rateSamples.push({ rate: (nextConsumed - newest.consumedAtSend) / rtt, at });
+      lastRateAt = at;
+      if (rateSamples.length > RATE_SAMPLES) rateSamples.shift();
+      hasSampledRate = true;
+    }
+    while (rttSamples.length > 0 && rttSamples[rttSamples.length - 1]!.rtt >= rtt) {
+      rttSamples.pop();
+    }
+    rttSamples.push({ rtt, at });
+    latestRtt = rtt;
+  }
+
+  // Never expires the newest sample, so a minimum RTT is always kept.
+  function expireRtt(at: number): void {
+    while (rttSamples.length > 1 && at - rttSamples[0]!.at > RTT_MEMORY_MS) {
+      rttSamples.shift();
+    }
+  }
+
+  function expireRateSamples(at: number): void {
+    while (rateSamples.length > 0 && at - rateSamples[0]!.at > RTT_MEMORY_MS) {
+      rateSamples.shift();
+    }
+  }
+
+  // Halve once per full memory period since the last rate sample (or the last
+  // halving), so a long idle gap shrinks a stale window in proportion.
+  function shrinkWindow(at: number): void {
+    const since = lastShrinkAt ?? lastRateAt;
+    const periods = Math.floor((at - since) / RTT_MEMORY_MS);
+    if (periods < 1) return;
+    effectiveWindow = Math.max(minWindow, Math.floor(effectiveWindow / 2 ** Math.min(periods, 30)));
+    lastShrinkAt = since + periods * RTT_MEMORY_MS;
+  }
+
+  function updateWindow(at: number): void {
+    if (rttSamples.length === 0) {
+      effectiveWindow = minWindow;
+      lastShrinkAt = undefined;
+      return;
+    }
+    if (rateSamples.length === 0) {
+      if (hasSampledRate) {
+        shrinkWindow(at);
+      } else {
+        effectiveWindow = minWindow;
+      }
+      return;
+    }
+    lastShrinkAt = undefined;
+    const minRtt = rttSamples[0]!.rtt;
+    const target = 2 * Math.max(...rateSamples.map((sample) => sample.rate)) * minRtt;
+    // Heuristic: a round trip well above the minimum suggests our own bytes are
+    // queued; never grow then, so a shared slow link does not bloat.
+    const queued = latestRtt > 2 * minRtt + QUEUE_SLACK_MS;
+    const next = queued ? Math.min(target, effectiveWindow) : target;
+    effectiveWindow = Math.max(minWindow, Math.min(maxWindow, next));
+  }
+
+  function measure(nextConsumed: number): void {
+    const at = currentTime();
+    recordSamples(nextConsumed, at);
+    expireRtt(at);
+    expireRateSamples(at);
+    updateWindow(at);
+  }
+
+  function drain(): void {
+    while (queue.length > 0) {
+      const next = queue[0]!;
+      if (!canSend(next.bytes)) return;
+      queue.shift();
+      pendingBytes -= next.bytes;
+      if (pressured && pendingBytes <= resumeAt) setPressure(false);
+      sendUpdate(next.update, next.bytes);
+    }
+  }
+
+  return {
+    get sent(): number {
+      return sent;
+    },
+    get consumed(): number {
+      return consumed;
+    },
+    get pendingBytes(): number {
+      return pendingBytes;
+    },
+    get pressured(): boolean {
+      return pressured;
+    },
+    get window(): number {
+      return effectiveWindow;
+    },
+    offer(update: T, bytes: number): void {
+      if (disposed) return;
+      checkStall();
+      if (queue.length === 0 && canSend(bytes)) {
+        sendUpdate(update, bytes);
+        return;
+      }
+      pendingBytes += bytes;
+      if (pendingBytes >= pauseAt) setPressure(true);
+      if (pendingBytes > maxPending) {
+        overflow();
+        return;
+      }
+      queue.push({ update, bytes });
+    },
+    credit(value: number): void {
+      if (disposed) return;
+      checkStall();
+      const nextConsumed = Math.min(value, sent);
+      if (nextConsumed <= consumed) return;
+      measure(nextConsumed);
+      consumed = nextConsumed;
+      if (sent > consumed) {
+        inFlightSince = currentTime();
+      } else {
+        inFlightSince = undefined;
+      }
+      drain();
+    },
+    check(): void {
+      if (disposed) return;
+      checkStall();
+    },
+    dispose(): void {
+      if (disposed) return;
+      disposed = true;
+      queue = [];
+      pendingBytes = 0;
+      setPressure(false);
+    },
+  };
+}
diff --git a/packages/wire/src/api/credit-protocol.test.ts b/packages/wire/src/api/credit-protocol.test.ts
new file mode 100644
index 000000000..918ac365b
--- /dev/null
+++ b/packages/wire/src/api/credit-protocol.test.ts
@@ -0,0 +1,153 @@
+import { describe, expect, it, vi } from 'vitest';
+import type { Controller } from './controller';
+import { isWireMessage, type WireMessage, type WireTransport } from './protocol';
+import { serve } from './serve';
+
+function createLoopbackTransports(): {
+  clientTransport: WireTransport;
+  serverTransport: WireTransport;
+} {
+  const clientHandlers = new Set<(message: WireMessage) => void>();
+  const serverHandlers = new Set<(message: WireMessage) => void>();
+
+  const clientTransport: WireTransport = {
+    post(message) {
+      for (const handler of serverHandlers) handler(message);
+    },
+    onMessage(handler) {
+      clientHandlers.add(handler);
+      return () => clientHandlers.delete(handler);
+    },
+    onDisconnect() {
+      return () => {};
+    },
+  };
+
+  const serverTransport: WireTransport = {
+    post(message) {
+      for (const handler of clientHandlers) handler(message);
+    },
+    onMessage(handler) {
+      serverHandlers.add(handler);
+      return () => serverHandlers.delete(handler);
+    },
+    onDisconnect() {
+      return () => {};
+    },
+  };
+
+  return { clientTransport, serverTransport };
+}
+
+function createController(): Controller {
+  const source = {
+    subscribe: vi.fn(() => () => {}),
+  };
+
+  return {
+    call: vi.fn(),
+    acquireLive: () => ({
+      ready: async () => source,
+      release: async () => {},
+    }),
+  } as unknown as Controller;
+}
+
+async function attach(
+  clientTransport: WireTransport,
+  message: WireMessage,
+  id: string
+): Promise<WireMessage> {
+  const received: WireMessage[] = [];
+  const unsubscribe = clientTransport.onMessage((incoming) => received.push(incoming));
+  clientTransport.post(message);
+
+  await vi.waitFor(() => {
+    expect(received.some((incoming) => incoming.kind === 'result' && incoming.id === id)).toBe(
+      true
+    );
+  });
+
+  unsubscribe();
+  return received.find((incoming) => incoming.kind === 'result' && incoming.id === id)!;
+}
+
+describe('credit protocol', () => {
+  it('accepts valid topic-credit messages and rejects malformed ones', () => {
+    expect(isWireMessage({ kind: 'topic-credit', topic: 'log', consumed: 10 })).toBe(true);
+    expect(isWireMessage({ kind: 'topic-credit', consumed: 10 })).toBe(false);
+    expect(isWireMessage({ kind: 'topic-credit', topic: 'log', consumed: -1 })).toBe(false);
+    expect(isWireMessage({ kind: 'topic-credit', topic: 'log', consumed: 1.5 })).toBe(false);
+
+    expect(isWireMessage({ kind: 'topic-pressure', topic: 'log', paused: true })).toBe(true);
+    expect(isWireMessage({ kind: 'topic-pressure', topic: 'log', paused: 'true' })).toBe(false);
+    expect(isWireMessage({ kind: 'topic-pressure', topic: 'log' })).toBe(false);
+    expect(isWireMessage({ kind: 'topic-pressure', paused: true })).toBe(false);
+
+    expect(isWireMessage({ kind: 'attach', id: 'a', topic: 'log', window: 4096 })).toBe(true);
+    expect(isWireMessage({ kind: 'attach', id: 'a', topic: 'log', window: -1 })).toBe(false);
+    expect(isWireMessage({ kind: 'attach', id: 'a', topic: 'log', paused: true })).toBe(true);
+    expect(isWireMessage({ kind: 'attach', id: 'a', topic: 'log', paused: false })).toBe(false);
+    expect(isWireMessage({ kind: 'attach', id: 'a', topic: 'log', paused: 'true' })).toBe(false);
+  });
+
+  it('replies to an attach without a window with the old undefined result', async () => {
+    const { clientTransport, serverTransport } = createLoopbackTransports();
+    const unsubscribeServe = serve(serverTransport, createController());
+
+    try {
+      const result = await attach(
+        clientTransport,
+        { kind: 'attach', id: 'attach-no-window', topic: 'log' },
+        'attach-no-window'
+      );
+
+      expect(result).toEqual({
+        kind: 'result',
+        id: 'attach-no-window',
+        ok: true,
+        value: undefined,
+      });
+    } finally {
+      unsubscribeServe();
+    }
+  });
+
+  it('replies to an attach with a window with the offered window', async () => {
+    const { clientTransport, serverTransport } = createLoopbackTransports();
+    const unsubscribeServe = serve(serverTransport, createController());
+
+    try {
+      const result = await attach(
+        clientTransport,
+        { kind: 'attach', id: 'attach-window', topic: 'log', window: 4096 },
+        'attach-window'
+      );
+
+      expect(result).toEqual({
+        kind: 'result',
+        id: 'attach-window',
+        ok: true,
+        value: { window: 4096 },
+      });
+    } finally {
+      unsubscribeServe();
+    }
+  });
+
+  it('drops unknown message kinds', async () => {
+    const { clientTransport, serverTransport } = createLoopbackTransports();
+    const unsubscribeServe = serve(serverTransport, createController());
+    const received: WireMessage[] = [];
+    const unsubscribeMessage = clientTransport.onMessage((message) => received.push(message));
+
+    try {
+      clientTransport.post({ kind: 'made-up' } as unknown as WireMessage);
+      await new Promise((resolve) => setTimeout(resolve, 0));
+      expect(received).toEqual([]);
+    } finally {
+      unsubscribeMessage();
+      unsubscribeServe();
+    }
+  });
+});
