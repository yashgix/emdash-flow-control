+    ids.add(attachId);
+    if (ids.size > MAX_ABANDONED_PER_TOPIC) ids.delete(ids.values().next().value as string);
+    abandonedAttachIds.set(topic, ids);
+    if (abandonedAttachIds.size > MAX_ABANDONED_TOPICS) {
