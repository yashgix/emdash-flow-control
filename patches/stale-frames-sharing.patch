+    h.pair.serverToClient.held = true;
+    h.subscriptions[0].push(u1);
+    detachSecond();
+    const updates: LiveUpdate[] = [];
+    const reopened = second.attach(topic, (update) => updates.push(update));
+    h.pair.serverToClient.flush();
+    await reopened;
